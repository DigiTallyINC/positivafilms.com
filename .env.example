# Vercel env vars required for the autonomous blog cron.
# Set these in Vercel project settings → Environment Variables.
# The static site itself does NOT use any of these.

# Anthropic API key — pay-as-you-go credits, decoupled from any Claude.ai subscription
ANTHROPIC_API_KEY=sk-ant-...

# GitHub fine-grained PAT with: contents:write on DigiTallyINC/positivafilms.com
GITHUB_TOKEN=github_pat_...

# Repo coordinates
GITHUB_OWNER=DigiTallyINC
GITHUB_REPO=positivafilms.com
GITHUB_BRANCH=master

# Random shared secret. Vercel cron passes "Authorization: Bearer ${CRON_SECRET}".
# Generate: openssl rand -hex 32
CRON_SECRET=
